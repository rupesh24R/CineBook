# ============================================================
# CineBook Full-Stack Cinema Booking Platform
# Environment Configuration Template
# ============================================================

# --- BACKEND / DATABASE (Supabase PostgreSQL) ---
# Replace YOUR_PROJECT_REF and YOUR_PASSWORD with your Supabase credentials:
# 1. Sign up / login at https://supabase.com
# 2. Go to Project Settings -> Database -> Connection String (URI / JDBC)
# 3. Enable SSL mode (?sslmode=require)
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_DRIVER=org.postgresql.Driver
PORT=8080

# --- FRONTEND (Vercel) ---
# Set this in your Vercel Project Environment Variables to point to your live backend:
VITE_API_URL=https://cinebook-backend.onrender.com

