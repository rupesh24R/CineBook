# CineBook - Supabase PostgreSQL Environment Configuration
# Copy this file to .env or configure in your hosting platform (Render, Heroku, Railway)

# Supabase direct or pooler connection URL
# Example (Direct): jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Example (Session Pooler): jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
DB_DRIVER=org.postgresql.Driver

# Server port (Render sets this dynamically)
PORT=8080

